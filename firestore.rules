rules_version = '2';

// Règles Firestore de La P'tite Boutik Solidaire.
// À coller dans la console Firebase : Firestore Database → Règles → Publier.
// (Ce fichier sert de référence : il n'est pas déployé automatiquement.)
//
// Principe : tout le monde peut LIRE ce que le site affiche ;
// seuls les admins connectés avec Google peuvent ÉCRIRE.
// Un admin = un document admins/<adresse e-mail en minuscules>.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'belletonv@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
      );
    }

    // Contenu public du site : lecture pour tous, écriture admin
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /fermetures/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /ouvertures_exceptionnelles/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /photos/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Liste des admins : un compte connecté peut vérifier sa propre fiche,
    // seuls les admins voient la liste complète et la modifient.
    match /admins/{email} {
      allow get: if signedIn() && email == request.auth.token.email.lower();
      allow read, write: if isAdmin();
    }

    // Tout le reste est fermé
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
